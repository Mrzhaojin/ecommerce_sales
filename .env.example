# ============================================================
# 环境变量示例文件（不含真实密码，可提交到版本库）
# 使用方式：复制为 .env 后按本机环境填写
# ============================================================

# ---------------- Flask 运行配置 ----------------
FLASK_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_SECRET_KEY=please-change-me

# ---------------- MySQL 数据库配置 ----------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce_db
