# ============================================================
# Git 忽略配置（电商销售数据可视化平台）
# 说明：所有可能泄露隐私（密码 / 密钥 / 令牌）的文件一律忽略，
#       仅允许提交 .env.example 这类不含真实值的模板。
# ============================================================

# ---------------- 环境变量（含数据库密码 / 会话密钥，严禁提交） ----------------
.env
.env.*
!.env.example

# ---------------- Node.js / 前端依赖 ----------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------- Vite / 前端打包产物 ----------------
dist/
dist-ssr/
*.local

# ---------------- Python 字节码与缓存 ----------------
__pycache__/
*.py[cod]
*$py.class
*.so

# ---------------- Python 虚拟环境 ----------------
.venv/
venv/
env/

# ---------------- 打包与构建产物 ----------------
build/
*.egg-info/

# ---------------- 数据库与日志 ----------------
*.sqlite3
*.log

# ---------------- 测试与覆盖率 ----------------
.pytest_cache/
.coverage
htmlcov/

# ---------------- 编辑器与系统文件 ----------------
.idea/
.vscode/
.DS_Store
Thumbs.db
